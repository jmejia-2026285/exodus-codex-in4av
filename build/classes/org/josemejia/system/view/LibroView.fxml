                                       <children>
                                          <Button fx:id="btnLimpiar" maxWidth="Infinity" onAction="#handleLimpiar" styleClass="boton-secundario" text="Limpiar" HBox.hgrow="ALWAYS" />
                                          <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#handleEliminar" styleClass="boton-peligro" text="Eliminar" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
