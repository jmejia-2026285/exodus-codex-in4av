                                    <Region maxWidth="175.0" minHeight="0.0" prefHeight="0.0" prefWidth="175.0" styleClass="regla-dorada" />
                                    <VBox spacing="3">
                                       <children>
                                          <Label styleClass="campo-etiqueta" text="TÍTULO" />
