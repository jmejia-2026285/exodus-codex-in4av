<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="660.0" prefWidth="1060.0" styleClass="pantalla-fondo" stylesheets="@../resources/styles/styles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.josemejia.system.controller.LibroController">
   <children>
      <VBox fx:id="raiz" prefHeight="660" prefWidth="1060" styleClass="pantalla-fondo">
         <children>
            <HBox alignment="CENTER" spacing="18" styleClass="barra-superior">
               <children>
                  <ImageView fitHeight="71.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../resources/images/gif/folder.gif" />
                     </image>
                  </ImageView>
                  <ImageView fitHeight="162.0" fitWidth="259.0" preserveRatio="true">
                     <image>
                        <Image url="@../resources/images/logo.png" />
                     </image>
                  </ImageView>
                  <Button fx:id="btnBuscar" onAction="#handleBuscar" prefHeight="48.0" prefWidth="96.0" styleClass="boton-dorado" stylesheets="@../resources/styles/styles.css" text="Buscar" />
                  <TextField fx:id="txtBuscar" prefHeight="50.0" prefWidth="375.0" promptText="Buscar libro por título, autor o ISBN..." styleClass="campo-texto" />
                  <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="boton-secundario" text="Volver al menú" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="14" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="26" left="26" right="26" top="26" />
               </padding>
               <children>
                  <VBox alignment="BASELINE_LEFT" spacing="6" styleClass="catalogo-header">
                     <children>
                        <VBox prefHeight="0.0" prefWidth="963.0" />
                        <Label prefHeight="33.0" prefWidth="321.0" styleClass="dashboard-titulo" text="Catálogo bibliográfico" />
                        <Label fx:id="lblTotalLibros" styleClass="dashboard-subtitulo" text="0 títulos registrados" />
                        <Region maxHeight="6.0" maxWidth="294.0" minHeight="0.0" prefHeight="6.0" prefWidth="294.0" styleClass="regla-dorada">
                           <cursor>
                              <Cursor fx:constant="DEFAULT" />
                           </cursor></Region>
                     </children>
                  </VBox>
                  <BorderPane VBox.vgrow="ALWAYS">
                     <center>
                        <ScrollPane fx:id="scrollCatalogo" fitToWidth="true" styleClass="scroll-catalogo">
                           <content>
                              <FlowPane fx:id="panelTarjetas" hgap="18" styleClass="grilla-tarjetas" vgap="18">
                                 <padding>
                                    <Insets bottom="4" left="4" right="18" top="4" />
                                 </padding>
                              </FlowPane>
                           </content>
                        </ScrollPane>
                     </center>
                     <right>
                        <ScrollPane fitToWidth="true" prefHeight="397.0" prefWidth="306" styleClass="scroll-formulario">
