<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- TODO: reemplaza "com.grupo.biblioteca" por tu paquete real en fx:controller de abajo -->
<VBox fx:id="raiz" alignment="CENTER" styleClass="login-container" prefWidth="820" prefHeight="600"
      stylesheets="@../resources/styles/styles.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.grupo.biblioteca.controller.RegistroBibliotecarioController">

    <HBox VBox.vgrow="ALWAYS">

        <!-- Panel izquierdo: marca, mismo estilo navy que ya usa el Login -->
        <VBox styleClass="panel-marca" alignment="CENTER" spacing="18" prefWidth="300" HBox.hgrow="NEVER">
            <padding>
                <Insets top="40" right="30" bottom="40" left="30"/>
            </padding>

            <VBox styleClass="logo-placa" alignment="CENTER">
                <ImageView fitWidth="110" preserveRatio="true">
                    <image>
                        <Image url="@../resources/image/logo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Label text="Únete al equipo" styleClass="panel-marca-titulo" wrapText="true" textAlignment="CENTER"/>
            <Label text="Crea el acceso de un nuevo bibliotecario para administrar el catálogo."
                   styleClass="panel-marca-texto" wrapText="true" textAlignment="CENTER"/>
            <Label text="&quot;Solo el Bibliotecario Jefe puede crear cuentas nuevas.&quot;"
                   styleClass="panel-marca-cita" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- Panel derecho: formulario -->
        <ScrollPane fitToWidth="true" styleClass="scroll-formulario panel-acceso" HBox.hgrow="ALWAYS">
            <VBox styleClass="panel-acceso login-form" spacing="14">
                <padding>
                    <Insets top="40" right="46" bottom="40" left="46"/>
                </padding>

                <Label text="NUEVA CUENTA" styleClass="eyebrow"/>
                <Region styleClass="regla-dorada"/>
                <Label text="Registrar bibliotecario" styleClass="marca-titulo"/>

                <HBox spacing="14">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="NOMBRE" styleClass="campo-etiqueta"/>
                        <TextField fx:id="txtNombre" styleClass="campo-texto"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="APELLIDO" styleClass="campo-etiqueta"/>
                        <TextField fx:id="txtApellido" styleClass="campo-texto"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="CORREO ELECTRÓNICO" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtCorreo" promptText="correo@universidad.edu" styleClass="campo-texto"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="NOMBRE DE USUARIO" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtUsuario" styleClass="campo-texto"/>
                </VBox>

                <HBox spacing="14">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="CONTRASEÑA" styleClass="campo-etiqueta"/>
                        <PasswordField fx:id="txtPassword" styleClass="campo-texto"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="CONFIRMAR CONTRASEÑA" styleClass="campo-etiqueta"/>
                        <PasswordField fx:id="txtConfirmarPassword" styleClass="campo-texto"/>
                    </VBox>
                </HBox>

                <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true"/>

                <HBox spacing="12">
                    <Button fx:id="btnCancelar" text="Cancelar" styleClass="boton-secundario"
                            onAction="#handleCancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnRegistrar" text="Registrar cuenta" styleClass="boton-primario"
                            onAction="#handleRegistrar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>
