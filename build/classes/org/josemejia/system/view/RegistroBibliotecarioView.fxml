<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" alignment="CENTER" styleClass="login-container" prefWidth="1000" prefHeight="1000"
      stylesheets="@../resources/styles/styles.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.josemejia.sgb.controller.RegistroBibliotecarioController">

    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-formulario" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" styleClass="login-container">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER" spacing="0" styleClass="tarjeta-elevada" maxWidth="760">

                <VBox styleClass="panel-marca" alignment="CENTER" spacing="16" prefWidth="260" minWidth="260">
                    <ImageView fitWidth="90" preserveRatio="true">
                        <image>
                            <Image url="@../resources/image/logo-blanco.png"/>
                        </image>
                    </ImageView>
                    <Label text="EXODUS CODEX" styleClass="panel-marca-titulo" wrapText="true" textAlignment="CENTER"/>
                    <Region styleClass="regla-dorada-panel"/>
                    <Label text="Sistema de gestión bibliotecaria" styleClass="panel-marca-subtitulo" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Registrar bibliotecario" styleClass="marca-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="NUEVA CUENTA" styleClass="eyebrow"/>
                    </HBox>

                    <Label text="Solo el Bibliotecario Jefe puede crear cuentas nuevas." styleClass="marca-subtitulo" wrapText="true"/>

                    <HBox spacing="14">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="NOMBRE" styleClass="campo-etiqueta"/>
                            <TextField fx:id="txtNombre" styleClass="campo-texto"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="APELLIDO" styleClass="campo-etiqueta"/>
                            <TextField fx:id="txtApellido" styleClass="campo-texto"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="CORREO ELECTRÓNICO" styleClass="campo-etiqueta"/>
                        <TextField fx:id="txtCorreo" promptText="correo@universidad.edu" styleClass="campo-texto"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="NOMBRE DE USUARIO" styleClass="campo-etiqueta"/>
                        <TextField fx:id="txtUsuario" styleClass="campo-texto"/>
                    </VBox>

                    <HBox spacing="14">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="CONTRASEÑA" styleClass="campo-etiqueta"/>
                            <PasswordField fx:id="txtPassword" styleClass="campo-texto"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="CONFIRMAR CONTRASEÑA" styleClass="campo-etiqueta"/>
                            <PasswordField fx:id="txtConfirmarPassword" styleClass="campo-texto"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true"/>

                    <HBox spacing="12">
                        <Button fx:id="btnCancelar" text="Cancelar" styleClass="boton-secundario"
                                onAction="#handleCancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnRegistrar" text="Registrar cuenta" styleClass="boton-primario"
                                onAction="#handleRegistrar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>