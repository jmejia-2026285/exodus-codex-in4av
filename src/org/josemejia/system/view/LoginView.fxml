<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox fx:id="raiz" alignment="CENTER" styleClass="login-container" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox prefHeight="560.0" prefWidth="900.0">
         <children>
            <VBox prefWidth="420.0" spacing="22.0" styleClass="panel-marcar">
               <padding>
                  <Insets bottom="52.0" left="44.0" right="44.0" top="52.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER_LEFT" prefWidth="420" spacing="22" styleClass="panel-marca">
                     <padding>
                        <Insets bottom="52" left="44" right="44" top="52" />
                     </padding>
                     <children>
                        <VBox maxWidth="-Infinity" styleClass="logo-placa">
                           <children>
                              <ImageView fx:id="imgLogo" fitWidth="240.0" preserveRatio="true" />
                           </children>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Region styleClass="regla-dorada" />
                        <Label styleClass="panel-marca-titulo" text="Sistema de gestión bibliotecaria" wrapText="true" />
                        <Label styleClass="panel-marca-texto" text="Catálogo, préstamos y usuarios de la librería universitaria en un solo lugar." wrapText="true" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Label styleClass="panel-marca-cita" text="“Un libro prestado es conocimiento en movimiento.”" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="6.0" styleClass="panel-acceso" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="52.0" left="60.0" right="60.0" top="52.0" />
               </padding>
               <children>
                  <VBox maxWidth="340.0" spacing="6.0">
                     <children>
                        <Label styleClass="eyebrow" text="ACCESO AL SISTEMA" />
                        <Label styleClass="marca-titulo" text="Iniciar sesión" />
                        <Label text="Ingresa con tus credenciales institucionales." />
                     </children>
                  </VBox>
                  <VBox maxWidth="340.0" spacing="12.0" styleClass="login-form">
                     <padding>
                        <Insets top="26.0" />
                     </padding>
                     <children>
                        <VBox spacing="6.0" />
                        <VBox maxWidth="340" spacing="12" styleClass="login-form">
                           <padding>
                              <Insets top="26" />
                           </padding>
                           <children>
                              <VBox spacing="6">
                                 <children>
                                    <Label styleClass="campo-etiqueta" text="USUARIO" />
                                    <TextField fx:id="txtUsuario" promptText="usuario.biblioteca" styleClass="campo-texto" />
                                 </children>
                              </VBox>
                              <VBox spacing="6">
                                 <children>
                                    <Label styleClass="campo-etiqueta" text="CONTRASEÑA" />
                                    <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="campo-texto" />
                                 </children>
                              </VBox>
                              <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true" />
                              <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" styleClass="boton-primario" text="Entrar al sistema" />
                              <Label styleClass="marca-subtitulo" text="Exodus Codex · v1.0" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
