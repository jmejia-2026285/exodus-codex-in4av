<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    fx:id="raiz"
    prefHeight="620.0"
    prefWidth="1000.0"
    styleClass="dashboard-root"
    stylesheets="@../resources/styles/styles.css"
    xmlns="http://javafx.com/javafx/23.0.2"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.josemejia.system.controller.DashboardController">

    <!-- ========================================================= -->
    <!-- BARRA LATERAL                                             -->
    <!-- ========================================================= -->
    <left>
        <VBox
            prefWidth="256.0"
            spacing="16.0"
            styleClass="dashboard-sidebar">

            <padding>
                <Insets
                    bottom="26.0"
                    left="18.0"
                    right="18.0"
                    top="26.0" />
            </padding>

            <!-- Logo -->
            <VBox
                maxWidth="Infinity"
                prefHeight="32.0"
                prefWidth="220.0"
                styleClass="logo-placa">

                <ImageView
                    fitHeight="111.0"
                    fitWidth="207.0"
                    preserveRatio="true">

                    <image>
                        <Image url="@../resources/images/logo.png" />
                    </image>

                </ImageView>
            </VBox>

            <!-- Subtítulo -->
            <Label
                styleClass="marca-subtitulo-oscuro"
                text="SISTEMA DE GESTION BIBLIOTECARIA"
                wrapText="true" />

            <Region
                maxWidth="Infinity"
                styleClass="sidebar-separador" />

            <!-- Usuario -->
            <HBox
                alignment="CENTER_LEFT"
                spacing="12.0">

                <Label
                    styleClass="sidebar-avatar"
                    text="EC" />

                <VBox spacing="2.0">

                    <Label
                        fx:id="lblBienvenida"
                        styleClass="sidebar-bienvenida"
                        wrapText="true" />

                    <Label
                        fx:id="lblRol"
                        styleClass="sidebar-rol" />

                </VBox>
            </HBox>

            <Region
                maxWidth="Infinity"
                styleClass="sidebar-separador" />

            <!-- Navegación -->
            <Label
                styleClass="sidebar-seccion"
                text="NAVEGACIÓN" />

            <Button
                fx:id="btnCatalogo"
                maxWidth="Infinity"
                onAction="#handleCatalogo"
                styleClass="boton-sidebar"
                text="Catálogo bibliográfico" />

            <Button
                fx:id="btnRegistrarBibliotecario"
                maxWidth="Infinity"
                onAction="#handleRegistrarBibliotecario"
                styleClass="boton-sidebar"
                text="Registrar bibliotecario" />

            <!-- Espaciador -->
            <Region
                VBox.vgrow="ALWAYS" />

            <!-- Cerrar sesión -->
            <Button
                fx:id="btnCerrarSesion"
                maxWidth="Infinity"
                onAction="#handleCerrarSesion"
                styleClass="boton-salir"
                text="Cerrar sesión" />

        </VBox>
    </left>


    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL                                       -->
    <!-- ========================================================= -->
    <right>
        <ScrollPane
            fitToWidth="true"
            prefHeight="501.0"
            prefWidth="1087.0"
            styleClass="scroll-formulario"
            BorderPane.alignment="CENTER">

            <content>
                <VBox
                    spacing="26.0"
                    styleClass="dashboard-contenido">

                    <padding>
                        <Insets
                            bottom="48.0"
                            left="52.0"
                            right="52.0"
                            top="48.0" />
                    </padding>


                    <!-- ================================================= -->
                    <!-- ENCABEZADO                                        -->
                    <!-- ================================================= -->
                    <VBox spacing="10.0">

                        <Label
                            styleClass="eyebrow"
                            text="PANEL PRINCIPAL" />

                        <Region
                            maxWidth="166.0"
                            minHeight="1.0"
                            prefHeight="1.0"
                            prefWidth="166.0"
                            styleClass="regla-dorada">

                            <cursor>
                                <Cursor fx:constant="DEFAULT" />
                            </cursor>

                        </Region>

                        <Label
                            styleClass="dashboard-titulo"
                            text="Bienvenido a Exodus Codex" />

                    </VBox>


                    <!-- ================================================= -->
                    <!-- RESUMEN GENERAL                                   -->
                    <!-- ================================================= -->
                    <VBox spacing="14.0">

                        <Label
                            styleClass="sidebar-seccion"
                            text="Funcionalidad:" />

                        <HBox spacing="16.0">

                            <!-- Tarjeta catálogo -->
                            <VBox
                                spacing="6.0"
                                styleClass="tarjeta-info"
                                HBox.hgrow="ALWAYS">

                                <Label
                                    styleClass="eyebrow"
                                    text="CATÁLOGO" />

                                <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="8.0">

                                    <ImageView
                                        fitHeight="59.0"
                                        fitWidth="58.0"
                                        preserveRatio="true">

                                        <image>
                                            <Image url="@../resources/images/gif/performance.gif" />
                                        </image>

                                    </ImageView>

                                    <Label
                                        styleClass="tarjeta-info-numero"
                                        text="Títulos y copias" />

                                </HBox>

                                <Label
                                    styleClass="tarjeta-info-texto"
                                    text="Consulta, agrega y edita libros con su portada."
                                    wrapText="true" />

                            </VBox>


                            <!-- Tarjeta cuentas -->
                            <VBox
                                spacing="6.0"
                                styleClass="tarjeta-info"
                                HBox.hgrow="ALWAYS">

                                <Label
                                    styleClass="eyebrow"
                                    text="CUENTAS" />

                                <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="8.0">

                                    <ImageView
                                        fitHeight="60.0"
                                        fitWidth="70.0"
                                        preserveRatio="true">

                                        <image>
                                            <Image url="@../resources/images/gif/Users.gif" />
                                        </image>

                                    </ImageView>

                                    <Label
                                        styleClass="tarjeta-info-numero"
                                        text="Bibliotecarios" />

                                </HBox>

                                <Label
                                    styleClass="tarjeta-info-texto"
                                    text="El jefe de biblioteca crea las cuentas del personal."
                                    wrapText="true" />

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- ACCESOS RÁPIDOS                                  -->
                    <!-- ================================================= -->
                    <VBox spacing="14.0">

                        <Label
                            styleClass="sidebar-seccion"
                            text="ACCESOS RÁPIDOS" />

                        <HBox spacing="16.0">

                            <!-- ========================================= -->
                            <!-- AGREGAR TÍTULO                            -->
                            <!-- ========================================= -->
                            <VBox
                                fx:id="tarjetaAgregarTitulo"
                                spacing="10.0"
                                styleClass="tarjeta-accion"
                                HBox.hgrow="ALWAYS">

                                <Label
                                    styleClass="tarjeta-accion-titulo"
                                    text="Agregar título" />

                                <Label
                                    styleClass="tarjeta-info-texto"
                                    text="Registra un nuevo libro con portada, autor y existencias."
                                    wrapText="true" />

                                <ImageView
                                    fitHeight="73.0"
                                    fitWidth="91.0"
                                    pickOnBounds="true"
                                    preserveRatio="true">

                                    <image>
                                        <Image url="@../resources/images/gif/folder.gif" />
                                    </image>

                                </ImageView>

                                <Button
                                    onAction="#handleCatalogo"
                                    styleClass="boton-secundario"
                                    text="Ir al catálogo" />

                            </VBox>


                            <!-- ========================================= -->
                            <!-- NUEVO BIBLIOTECARIO                       -->
                            <!-- ========================================= -->
                            <VBox
                                fx:id="tarjetaNuevoBibliotecario"
                                spacing="10.0"
                                styleClass="tarjeta-accion"
                                HBox.hgrow="ALWAYS">

                                <Label
                                    styleClass="tarjeta-accion-titulo"
                                    text="Nuevo bibliotecario" />

                                <Label
                                    styleClass="tarjeta-info-texto"
                                    text="Da de alta una cuenta de personal para operar el sistema."
                                    wrapText="true" />

                                <ImageView
                                    fitHeight="84.0"
                                    fitWidth="137.0"
                                    pickOnBounds="true"
                                    preserveRatio="true">

                                    <image>
                                        <Image url="@../resources/images/gif/bibliotecario.gif" />
                                    </image>

                                </ImageView>

                                <Button
                                    onAction="#handleRegistrarBibliotecario"
                                    styleClass="boton-primario"
                                    text="Registrar cuenta" />

                            </VBox>

                        </HBox>

                    </VBox>

                </VBox>
            </content>

        </ScrollPane>
    </right>

</BorderPane>
