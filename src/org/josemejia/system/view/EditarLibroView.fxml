<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" alignment="TOP_CENTER" prefWidth="340.0" spacing="8" styleClass="panel-formulario" stylesheets="@../resources/styles/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.josemejia.system.controller.EditarLibroController">
   <padding>
      <Insets bottom="24.0" left="26.0" right="26.0" top="24.0" />
   </padding>
   <children>
      <Label styleClass="panel-formulario-titulo" text="Editar libro" />
      <Region maxWidth="175.0" minHeight="0.0" prefHeight="0.0" prefWidth="175.0" styleClass="regla-dorada" />

      <ScrollPane fitToWidth="true" styleClass="scroll-formulario" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="8">
               <children>
                  <VBox spacing="3">
                     <children>
                        <Label styleClass="campo-etiqueta" text="TÍTULO" />
                        <TextField fx:id="txtTitulo" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="3">
                     <children>
                        <Label styleClass="campo-etiqueta" text="AUTOR PRINCIPAL" />
                        <TextField fx:id="txtAutor" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="3">
                     <children>
                        <Label styleClass="campo-etiqueta" text="EDITORIAL" />
                        <TextField fx:id="txtEditorial" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="3">
                     <children>
                        <Label styleClass="campo-etiqueta" text="AÑO" />
                        <TextField fx:id="txtAnio" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="3">
                     <children>
                        <Label styleClass="campo-etiqueta" text="ISBN" />
                        <TextField fx:id="txtIsbn" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="126.0" prefWidth="212.0" spacing="6">
                     <children>
                        <ImageView fx:id="imgPortadaPreview" fitHeight="90.0" fitWidth="77.0" preserveRatio="false" styleClass="libro-tarjeta-imagen" />
                        <Button fx:id="btnSeleccionarPortada" maxWidth="Infinity" onAction="#handleSeleccionarPortada" prefHeight="38.0" prefWidth="251.0" styleClass="boton-secundario" text="Seleccionar portada" />
                     </children>
                  </VBox>
                  <VBox spacing="3">
                     <children>
                        <Label styleClass="campo-etiqueta" text="COPIAS" />
                        <TextField fx:id="txtCopias" styleClass="campo-texto" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#handleGuardar" styleClass="boton-primario" text="Guardar cambios" />
      <HBox spacing="10">
         <children>
            <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#handleEliminar" styleClass="boton-peligro" text="Eliminar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" maxWidth="Infinity" onAction="#handleCancelar" styleClass="boton-secundario" text="Cancelar" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>
